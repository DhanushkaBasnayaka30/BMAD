# ==============================================================================
# FixNear - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate with your real project secrets.
# NEVER commit .env.local or expose real secrets to git or AI agents.
# ==============================================================================

# Supabase (Region: ap-south-1 Mumbai)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# WhatsApp Contact Event Deduplication Salt (Server-Only)
# SHA256(ip + user_agent + date + provider_id + CONTACT_HASH_SALT)
CONTACT_HASH_SALT=your-contact-hash-salt-minimum-32-random-characters

# Cloudflare Turnstile Anti-Spam
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Telegram Alerts for Provider Applications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# Phone Blocklist HMAC Secret (Server-Only)
# HMAC_SHA256(e164_phone_number, PHONE_BLOCKLIST_SECRET)
PHONE_BLOCKLIST_SECRET=your-phone-blocklist-secret-minimum-32-characters

# Public Support & Application URL
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=+94771234567
NEXT_PUBLIC_APP_URL=http://localhost:3000
